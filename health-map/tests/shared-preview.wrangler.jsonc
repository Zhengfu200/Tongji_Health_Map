{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tongji-backup-test-only",
  "main": "shared-preview-worker.mjs",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5174" },
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }]
}
